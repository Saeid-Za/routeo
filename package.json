{
	"name": "routeo",
	"type": "module",
	"private": true,
	"workspaces": [
		"packages/ui",
		"packages/tauri"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run build:ui && bun run build:tauri",
		"build:tauri": "bun run --filter './packages/tauri' build",
		"build:ui": "bun run --filter './packages/ui' build",
		"dev:ui": "bun run --filter './packages/ui' dev",
		"dev:tauri": "bun run --filter './packages/tauri' dev"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^6.0.3"
	}
}
